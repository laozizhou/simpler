# topo_queue runtime build configuration.
#
# The scheduling scheme lives in runtime/ (self-pulling AICore workers over a
# sorted task table) and replaces host_build_graph's scheduler/ wholesale. The
# graph, however, is deliberately NOT rebuilt: the host and orchestration
# targets compile host_build_graph's own sources, so graph construction,
# dependency derivation and upload are byte-identical to HBG's and topo_queue
# only differs on the device. That is a deliberate coupling — HBG's host side
# and the graph wire format (scheduler_graph.h) are the contract this runtime
# reads; a change there reaches topo_queue at the next build, loudly.
#
# Only aicpu/ and aicore/ are this runtime's own code.
HBG = "../host_build_graph"
SHARED = "../../../common/host_build_graph"

BUILD_CONFIG = {
    "aicore": {
        "include_dirs": ["runtime", f"{HBG}/runtime", f"{HBG}/common", "..", SHARED],
        "source_dirs": ["aicore"],
    },
    "aicpu": {
        "include_dirs": ["runtime", f"{HBG}/runtime", f"{HBG}/aicpu", f"{HBG}/common", "..", SHARED],
        "source_dirs": [
            "aicpu",
            f"{SHARED}/device",
            f"{SHARED}/shared",
        ],
    },
    "host": {
        "include_dirs": [f"{HBG}/runtime", f"{HBG}/common", "..", SHARED],
        "source_dirs": [
            f"{HBG}/host",
            f"{HBG}/orchestration",
            f"{SHARED}/host",
            f"{SHARED}/shared",
        ],
    },
    "orchestration": {
        "include_dirs": [f"{HBG}/runtime", f"{HBG}/orchestration", f"{HBG}/common", "..", SHARED],
        "source_dirs": [f"{HBG}/orchestration"],
    },
}
